{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/searisk/incident.schema.json",
  "title": "Normalized maritime incident",
  "type": "object",
  "required": ["id", "year", "role", "vessel", "eventType", "severity", "source"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "role": { "type": "string" },
    "vessel": { "type": "string" },
    "eventType": { "type": "string" },
    "severity": { "enum": ["none", "injury", "fatal"] },
    "source": {
      "type": "object",
      "required": ["publisher", "url", "retrievedAt"],
      "properties": {
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

